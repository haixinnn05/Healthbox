# Copy to .env and edit. Never commit .env.

# fake = built-in simulated controller; serial = real ESP-WROOM-32 over USB
HARDWARE_MODE=fake
# e.g. /dev/cu.usbserial-0001 or /dev/cu.SLAB_USBtoUART  (ls /dev/cu.*)
SERIAL_PORT=

# simulated | single_laptop | dual_camera
CAMERA_MODE=simulated
FACE_CAMERA_INDEX=0
# dual_camera only, e.g. http://192.168.4.20/snapshot
TRAY_CAMERA_URL=

TIMEZONE=America/New_York

# Prototype reminder defaults
SNOOZE_MINUTES=5
SOUND_INTERVAL_S=60
SOUND_MAX=3
NEEDS_REVIEW_MINUTES=15

# Calibrate on site
FACE_MATCH_THRESHOLD=0.363
FACE_MAX_AGE_S=2
TRAY_MAX_AGE_S=15
TRAY_TOKEN_AREA_PX=900

# AI (optional). off | developer_api | google_cloud
GENAI_BACKEND=off
# Check the model ID is available to your key in AI Studio before the demo.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# google_cloud backend only
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
AI_REQUEST_LIMIT=100

# Every plan entry needs a photo of its medication label (1) or not (0)
REQUIRE_LABEL_PHOTO=1
