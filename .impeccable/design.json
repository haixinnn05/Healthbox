      "css": ".ds-field{display:grid;gap:.4rem;font-weight:700;color:#16304f;font-family:var(--font)}.ds-field input{min-height:48px;padding:.55rem .85rem;border-radius:14px;border:2px solid var(--line-2,#b7cce3);background:var(--cloud,#fcfdff);font:inherit;font-weight:400}.ds-field input:focus{border-color:var(--focus,#1f5fae);outline:none;box-shadow:0 0 0 3px rgba(31,95,174,.25)}"
