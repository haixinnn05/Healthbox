  "components": [
    {
      "name": "Primary Button (big, ringed)",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action of a screen, at the big size, carrying the sun-deep ring.",
      "html": "<button class=\"ds-btn ds-btn-primary ds-btn-big ds-ringed\">Take my dose</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;min-height:48px;padding:.65rem 1.25rem;border-radius:var(--r-control,14px);border:2px solid var(--ink,#16304f);background:var(--cloud,#fcfdff);color:var(--ink,#16304f);font-family: var(--font); font-weight: 700;cursor:pointer;transition:background .18s cubic-bezier(.16,1,.3,1),transform .12s cubic-bezier(.16,1,.3,1)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px solid var(--focus,#1f5fae);outline-offset:3px}.ds-btn-primary{background:var(--ink,#16304f);color:#fcfdff}.ds-btn-primary:hover{background:#0f2540}.ds-btn-big{min-height:60px;padding:.9rem 2rem;font-size:var(--fs-lead,1.3rem)}.ds-ringed{position:relative}.ds-ringed::after{content:\"\";position:absolute;inset:-6px;border-radius:inherit;border:3px solid var(--sun-deep,#e9a93a);pointer-events:none}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Bordered ink action on cloud; also the form of an ordinary destructive action.",
      "html": "<button class=\"ds-btn2\">I need this now</button>",
      "css": ".ds-btn2{display:inline-flex;align-items:center;gap:.55rem;min-height:48px;padding:.65rem 1.25rem;border-radius:var(--r-control,14px);border:2px solid var(--ink,#16304f);background:var(--cloud,#fcfdff);color:var(--ink,#16304f);font-family: var(--font); font-weight: 700;cursor:pointer}.ds-btn2:hover{background:var(--cloud-2,#eef5fc)}.ds-btn2:active{transform:translateY(1px)}.ds-btn2:focus-visible{outline:3px solid var(--focus,#1f5fae);outline-offset:3px}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Side actions such as remind me later and read aloud.",
      "html": "<button class=\"ds-btn-quiet\">Remind me in 5 min</button>",
      "css": ".ds-btn-quiet{display:inline-flex;align-items:center;gap:.55rem;min-height:48px;padding:.65rem .8rem;border-radius:var(--r-control,14px);border:2px solid transparent;background:transparent;color:var(--ink-2,#33547a);font-family: var(--font); font-weight: 700;cursor:pointer}.ds-btn-quiet:hover{background:var(--cloud-2,#eef5fc);color:var(--ink,#16304f)}.ds-btn-quiet:focus-visible{outline:3px solid var(--focus,#1f5fae);outline-offset:3px}"
    },
    {
      "name": "STOP",
      "kind": "button",
      "refersTo": "button-stop",
      "description": "Always-visible red pill, isolated at the end of the top bar.",
      "html": "<button class=\"ds-stop\">STOP</button>",
      "css": ".ds-stop{display:inline-flex;align-items:center;gap:.5rem;min-height:52px;padding:.55rem 1.5rem;border:0;border-radius:999px;background:var(--stop,#c8322b);color:#fff;font-family: var(--font); font-weight: 700;letter-spacing:.06em;cursor:pointer}.ds-stop:hover{background:#ad261f}.ds-stop:active{transform:translateY(1px)}.ds-stop:focus-visible{outline:3px solid var(--focus,#1f5fae);outline-offset:3px}"
    },
    {
      "name": "Sky Tabs",
      "kind": "nav",
      "refersTo": "tab",
      "description": "Tabs on the sky band; the current tab is a cloud tile.",
      "html": "<nav class=\"ds-sky\"><a class=\"ds-tab\" aria-current=\"page\" href=\"#\">Today</a><a class=\"ds-tab\" href=\"#\">Ask</a><a class=\"ds-tab\" href=\"#\">Setup</a></nav>",
      "css": ".ds-sky{display:flex;gap:.25rem;padding:1rem;background:linear-gradient(180deg,#8ec2ee,#c9e3f8);border-radius:0 0 32px 32px}.ds-tab{display:inline-flex;align-items:center;min-height:48px;padding:.55rem 1.05rem;border-radius:14px;color:#16304f;font-family: var(--font); font-weight: 700;text-decoration:none}.ds-tab:hover{background:rgba(252,253,255,.4)}.ds-tab[aria-current=page]{background:rgba(252,253,255,.9)}.ds-tab:focus-visible{outline:3px solid #1f5fae;outline-offset:3px}"
    },
    {
      "name": "Tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Quiet pill tag.",
      "html": "<span class=\"ds-tag\">As needed</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;gap:.35rem;padding:.25rem .75rem;border-radius:999px;background:var(--cloud-2,#eef5fc);color:var(--ink-2,#33547a);font-family: var(--font); font-weight: 700;font-size:var(--fs-small,.875rem)}"
    },
    {
      "name": "Due Panel",
      "kind": "card",
      "refersTo": "panel-due",
      "description": "The dose due now: the one big thing on Today.",
      "html": "<section class=\"ds-due\"><h2>Afternoon tablet</h2><p class=\"ds-when\"><span class=\"ds-sun\"></span>Due now, 3:25 PM</p></section>",
      "css": ".ds-due{background:var(--cloud,#fcfdff);color:#16304f;border-radius:28px;padding:clamp(1.5rem,3vw,2.5rem);box-shadow:0 2px 4px rgba(22,48,79,.06),0 16px 36px rgba(22,48,79,.10);font-family:var(--font)}.ds-due h2{font-size:2.25rem;line-height:1.2;letter-spacing:-.02em;margin:0}.ds-when{display:flex;align-items:center;gap:.55rem;font-weight:700;color:#33547a;font-size:1.3rem;margin:.4rem 0 0}.ds-sun{width:1.1rem;height:1.1rem;border-radius:50%;background:radial-gradient(circle at 38% 34%,#fff1c9 0%,#ffd27a 48%,#e9a93a 100%)}"
