      "css": ".ds-marks{display:flex;align-items:center;gap:.5rem;color:#16304f;font-family:var(--font)}.ds-mark{width:.8rem;height:.8rem;border-radius:50%;border:2px solid #33547a}.ds-mark.done{background:#33547a}.ds-mark.wait{border-style:dashed}.ds-mark.skip{opacity:.55;background:linear-gradient(135deg,transparent 44%,#33547a 44% 56%,transparent 56%)}.ds-mark.alert{border-color:#b42318;background:#fdeceb}"
    }
